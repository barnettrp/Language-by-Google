# Copy this file to .env for local development and fill in real values.
# For production deployment, set these as environment variables in Vercel/deployment platform.
# Do NOT commit your .env file to version control.

# Firebase Configuration (required for authentication and database)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:your-app-id

# Gemini API Key (required for AI chat functionality)
# This should be set as a server-side environment variable in Vercel
GEMINI_API_KEY=your-gemini-api-key
