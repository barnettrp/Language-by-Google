# ===================================================================
# ConvoQuest - Environment Variables Configuration
# ===================================================================
# Copy this file to .env for local development and fill in real values.
# For production deployment, set these as environment variables in Vercel/deployment platform.
# 
# ⚠️  IMPORTANT: Do NOT commit your .env file to version control!
# ===================================================================

# ===================================================================
# FIREBASE CONFIGURATION (Required for authentication and database)
# ===================================================================
# Get these values from your Firebase Console:
# 1. Go to https://console.firebase.google.com
# 2. Select your project (or create a new one)
# 3. Go to Project Settings (gear icon) → General tab
# 4. Scroll down to "Your apps" section
# 5. Click on the web app or create a new web app
# 6. Copy the config values from the Firebase SDK snippet

# Your Firebase project's API key
VITE_FIREBASE_API_KEY=your-firebase-api-key

# Your Firebase project's auth domain (usually: your-project-id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Your Firebase project ID
VITE_FIREBASE_PROJECT_ID=your-project-id

# Your Firebase storage bucket (usually: your-project-id.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Your Firebase messaging sender ID (numeric)
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789

# Your Firebase app ID (starts with 1:)
VITE_FIREBASE_APP_ID=1:123456789:web:your-app-id

# ===================================================================
# GOOGLE GEMINI AI CONFIGURATION (Required for AI chat functionality)
# ===================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
# This should be set as a server-side environment variable in Vercel
# (it won't be exposed to the client)

GEMINI_API_KEY=your-gemini-api-key

# ===================================================================
# GOOGLE CLOUD APIs (Optional but recommended for enhanced features)
# ===================================================================
# These APIs enhance the learning experience with translation and text-to-speech.
# You can use the same API key as your Firebase project if these APIs are enabled.

# Google Cloud Translation API (for click-to-translate feature)
# Enable at: https://console.cloud.google.com/apis/library/translate.googleapis.com
# Allows users to click Spanish words/phrases to see English translations
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key

# Google Cloud Text-to-Speech API (for character voice generation)
# Enable at: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
# Provides natural-sounding character voices in quest conversations
# Falls back to GEMINI_API_KEY if not set
GOOGLE_CLOUD_TTS_API_KEY=your-google-tts-api-key

# ===================================================================
# SETUP VERIFICATION
# ===================================================================
# After setting up the above variables:
# 1. For local development: Run `npm run dev` and visit http://localhost:5173
# 2. For debugging: Visit http://localhost:5173/debug-config.html
# 3. For production: Ensure all VITE_* variables are set in Vercel dashboard

# ===================================================================
# QUICK SETUP CHECKLIST
# ===================================================================
# □ Firebase project created and configured
# □ Firebase Authentication enabled
# □ Firebase Firestore database created
# □ All VITE_FIREBASE_* variables filled in
# □ Gemini API key obtained and set
# □ (Optional) Google Cloud Translation API enabled and key configured
# □ (Optional) Google Cloud Text-to-Speech API enabled and key configured
# □ App tested locally and working
# □ Production environment variables configured in Vercel
